# 复制为项目根目录 .env，填写 API Key 后启动；其余配置可保持默认。
AI_PROVIDER=deepseek
AI_MODEL=deepseek-flash
AI_API_KEY=

# 以下为可选部署配置。
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
AUTH_ENABLED=false

# Account mode requires database migrations, SMS configuration and abuse protection.
AUTH_ALLOWED_ORIGINS=
AUTH_COOKIE_SECURE=true
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_SCHEME_NAME=

# 自定义域名部署时填写网站来源地址；默认本机访问无需填写。
AI_ALLOWED_ORIGINS=
