# Optional: copy to the repository root as .env. Do not reuse backend/.env.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
AUTH_ENABLED=false

# Account mode requires database migrations, SMS configuration and abuse protection.
AUTH_ALLOWED_ORIGINS=
AUTH_COOKIE_SECURE=true
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_SCHEME_NAME=
